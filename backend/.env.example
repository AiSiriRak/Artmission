# Copy to .env for local development (this happens automatically via `task dev`).
#
# Any nested key in internal/pkg/config/config.yaml can be overridden here,
# e.g. `auth.jwt_secret` -> AUTH_JWT_SECRET.
#
# Not needed for local dev — config.yaml's defaults already match this docker-compose.

# --- docker-compose postgres service ---
# POSTGRES_USER=user
# POSTGRES_PASSWORD=password
# POSTGRES_DB=artmission
# POSTGRES_PORT=5432

# --- docker-compose rustfs service ---
# RUSTFS_ACCESS_KEY=admin
# RUSTFS_SECRET_KEY=admin1234
# RUSTFS_PUBLIC_BUCKET=artmission-public
# RUSTFS_PRIVATE_BUCKET=artmission-private

# --- Slip2Go (required to generate real payment QR codes) ---
SLIP2GO_API_BASE_URL=https://connect.slip2go.com/api
SLIP2GO_SECRET_KEY=<your-slip2go-secret-key>
SLIP2GO_PROMPTPAY_CODE=<your-slip2go-promptpay-code>
SLIP2GO_PROMPTPAY_TYPE=phone_number
SLIP2GO_ACCOUNT_NAME=<your-slip2go-account-name>
